# ─────────────────────────────────────────────────────────────
#  Chauhan Properties — optional environment variables
#
#  This site is fully static: no database, no admin login, no
#  server. You do NOT need a .env file to build or deploy it —
#  everything works with the defaults baked into src/data/site.ts.
#
#  The only variable worth setting is the public URL, which is
#  used for sitemap.xml, robots.txt and social share cards. On
#  GitHub Actions set it as the repository variable SITE_URL.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://chauhan.qd.je
