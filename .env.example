# ─────────────────────────────────────────────────────────────
#  Chauhan Properties — environment template
#
#  Copy this file to `.env` for local development:
#      cp .env.example .env
#
#  On Vercel, add these under Project → Settings → Environment
#  Variables (do NOT paste this file into the repo with real
#  values — `.env` is git-ignored on purpose).
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local sandbox example:
#   postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production: use your Neon / Supabase connection string (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Code that protects /admin. Change this before going live!
# The demo default (used when this variable is missing) is: lucknow@2026
ADMIN_CODE=change-me-to-a-long-code

# Secret used to sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
ADMIN_SECRET=

# Public URL of the deployed site — used for sitemap.xml, robots.txt
# and social-share (Open Graph) links. No trailing slash.
# Example with a free DigitalPlat domain:
#   https://chauhanproperties.dpdns.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
